#!/usr/bin/env bash
# Tracker triage agent — a headless Claude session that classifies `new`
# tickets and nothing else. Local (launchd) replacement for the cloud
# routine, whose sandbox egress policy cannot reach the tracker host: there
# is no user-configurable domain allowlist for Claude Code cloud environments
# as of 2026-08, and the origin is firewalled to known IPs anyway.
#
# The policy this run is bound by lives in the PROJECT, not here
# (docs/BUG_TRACKER_TRIAGE_POLICY.md today) — the prompt reads it at run
# time, which is why this script cds into CREW_PROJECT_DIR first.
#
# Install on a 2-hour timer (optional):
#   cp crew/launchd/com.tablation.triage.plist ~/Library/LaunchAgents/   # after editing its paths
#   launchctl load ~/Library/LaunchAgents/com.tablation.triage.plist
set -euo pipefail

CREW_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CREW_CONFIG="${CREW_CONFIG:-$CREW_HOME/crew.config.sh}"
if [[ ! -f "$CREW_CONFIG" ]]; then
  echo "FATAL: no config at $CREW_CONFIG — copy crew.config.example.sh and fill it in" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$CREW_CONFIG"

# Same interlock as the dev loop, for the same reason: while this repo is a
# copy of a crew that is already running elsewhere, two triage agents would
# both classify the same ticket and both write to it.
if [[ "${CREW_ENABLED:-false}" != "true" ]]; then
  echo "crew: CREW_ENABLED is not true in $CREW_CONFIG — refusing to run." >&2
  echo "      This copy is inert until cutover; see docs/MIGRATION.md." >&2
  exit 0
fi

cd "$CREW_PROJECT_DIR"

# The same derived names lib/crew.sh expects from bin/crew. The triage seat
# runs alone, but it still shares the tracker with every other seat and has to
# name them the way they name each other.
BASE_URL="$CREW_BASE_URL"
USER_AGENT="${CREW_USER_AGENT:-Mozilla/5.0 TablationCrewAgent/1.0}"
DEV_TEAM_MEMBER_ID="$CREW_MEMBER_DEV"
DESIGN_TEAM_MEMBER_ID="$CREW_MEMBER_DESIGN"
QA_TEAM_MEMBER_ID="$CREW_MEMBER_QA"
OPERATOR_TEAM_MEMBER_ID="$CREW_OPERATOR"
log() { echo "$(date -u +%FT%TZ) $*" >&2; }
. "$CREW_HOME/lib/crew.sh"

# Roster first, for the same reason as the dev loop: the prompt below refers
# to the triage seat and to the operator generically, and this is what binds
# those words to names.
PROMPT=$(printf '%s\n\n%s' \
  "$(crew_roster_markdown triage)" \
  "$(cat "$CREW_HOME/prompts/triage-prompt.md")")

# BILLING: force the operator's Claude subscription, never an org's API
# credits. The server sidecar this replaced used to borrow ANTHROPIC_API_KEY
# out of the backend's .env and burned ~66.5M tokens in the week to
# 2026-08-22 on the API bill before anyone noticed — a lighter agent than the
# dev loop, expensive purely because of which credential it picked up. Either
# of these vars present in the environment silently takes precedence over the
# OAuth token, so they are unset at exec rather than merely left unassigned.
# Same guard, same reason, as bin/crew's run_agent.
exec env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u CLAUDE_CODE_USE_VERTEX \
    -u ANTHROPIC_VERTEX_PROJECT_ID -u ANTHROPIC_VERTEX_REGION -u CLOUD_ML_REGION \
    -u ANTHROPIC_MODEL \
  "$CREW_CLAUDE_BIN" -p "$PROMPT" --allowedTools Bash Read --model "$CREW_AGENT_MODEL"
