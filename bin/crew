#!/usr/bin/env node
// crew — the runner. See src/cli.ts.
//
// Runs the built output when it exists, and falls back to running TypeScript
// directly so a checkout works without a build step. The bash runner this
// replaces is kept as bin/crew-legacy.sh until cutover is done.
import { existsSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const here = dirname(fileURLToPath(import.meta.url));
const built = join(here, '..', 'dist', 'cli.js');
const source = join(here, '..', 'src', 'cli.ts');

if (existsSync(built)) {
  await import(pathToFileURL(built).href);
} else if (existsSync(source)) {
  // Node >=22.18 strips types natively; older needs --experimental-strip-types.
  await import(pathToFileURL(source).href);
} else {
  console.error('crew: no dist/cli.js and no src/cli.ts — is this a complete checkout?');
  process.exit(1);
}
