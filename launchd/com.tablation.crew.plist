<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tablation ticket-implementation loop, polled every 2 minutes (see
     crew/bin/crew). Each fire is a cheap curl/jq check
     against the tracker — the full agent session only runs when the check
     finds an accepted ticket or a new reply worth acting on. Runs while
     this Mac is on; pause anytime with
     `crew/bin/crew pause` (resume with `... resume`)
     — no need to unload this to pause.
     Install:  cp crew/launchd/com.tablation.crew.plist ~/Library/LaunchAgents/
               launchctl load ~/Library/LaunchAgents/com.tablation.crew.plist
     Remove:   launchctl unload ~/Library/LaunchAgents/com.tablation.crew.plist
     Logs:     /tmp/tablation-crew.log -->
<!-- __CREW_HOME__ is a placeholder: replace it with the absolute path
     of your crew checkout before copying this into ~/Library/LaunchAgents.
     launchd does not expand variables, ~ or relative paths. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tablation.crew</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CREW_HOME__/bin/crew</string>
  </array>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/tablation-crew.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tablation-crew.log</string>
</dict>
</plist>
