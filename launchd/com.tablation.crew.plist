<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The crew's `run` job, as a persistent service (ISSUE-763): `crew daemon`
     is a long-running loop that chains cycles immediately when there's work
     and backs off (up to the old 2-minute poll interval) when there isn't.
     KeepAlive restarts it if it ever exits; RunAtLoad starts it the moment
     this plist is loaded — "installed" means "running" for a real service.

     Stop it:                  launchctl unload this-plist (or `crew daemon stop`)
     Start it again:            launchctl load this-plist (or `crew daemon start`)
     Status:                    `crew daemon status`, or launchctl list <label>
     Watch:                     __CREW_HOME__/bin/crew watch
     Logs:                      /tmp/tablation-crew.log        (the crew's own)
                                /tmp/tablation-crew.launchd.log (only what
                                escapes it: a crash before the emitter exists)

     These MUST be different files. The emitter writes the first; launchd
     redirects stderr into the second. Pointing both at one file logs every
     line twice.

     node is named absolutely because launchd hands a script a minimal PATH
     with no node on it; PATH below is for whatever the project's hooks need.

     `release` and `passengers` are separate units on their own fixed
     timers, not shown here — see `crew install`, which writes all three.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tablation.crew</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__CREW_HOME__/bin/crew</string>
    <string>daemon</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_BIN_DIR__:/sbin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__CREW_HOME__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/tablation-crew.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tablation-crew.launchd.log</string>
</dict>
</plist>
