<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tablation triage agent on a 2-hour timer (see crew/bin/crew-triage).
     Install:  cp crew/launchd/com.tablation.triage.plist ~/Library/LaunchAgents/
               launchctl load ~/Library/LaunchAgents/com.tablation.triage.plist
     Remove:   launchctl unload ~/Library/LaunchAgents/com.tablation.triage.plist
     Logs:     /tmp/tablation-triage.log -->
<!-- __CREW_HOME__ is a placeholder: replace it with the absolute path
     of your crew checkout before copying this into ~/Library/LaunchAgents.
     launchd does not expand variables, ~ or relative paths. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tablation.triage</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CREW_HOME__/bin/crew-triage</string>
  </array>
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/tablation-triage.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tablation-triage.log</string>
</dict>
</plist>
