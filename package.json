{
  "name": "@tablation/crew",
  "version": "0.4.1",
  "description": "A standing team of headless agents that picks work off a Tablation board, does it on a machine you control, and reports back.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rightdesign/crew.git"
  },
  "homepage": "https://github.com/rightdesign/crew#readme",
  "bugs": {
    "url": "https://github.com/rightdesign/crew/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "crew": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "files": [
    "dist",
    "bin",
    "prompts",
    "crew.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "build:binaries": "scripts/build-binaries.sh",
    "dev": "tsx src/cli.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@tablation/client": "^0.1.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}
