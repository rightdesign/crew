#!/bin/sh
# Spike stand-in for `crew credential` (CREW-2783): a git credential helper that
# answers from the environment. The real helper reads the ship's forge token.
case "$1" in
  get)
    if [ -n "${CREW_FORGE_TOKEN:-}" ]; then
      printf 'username=x-access-token\npassword=%s\n' "$CREW_FORGE_TOKEN"
    fi
    ;;
  *) ;;
esac
